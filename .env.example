# ---------------------------------------------------------------
# Office AI Assistant — variables de entorno
# Copia este archivo como  .env  y coloca tu clave real.
# NUNCA subas el archivo .env a GitHub.
# ---------------------------------------------------------------

# Proveedor: gemini | openai | groq | anthropic | demo
# Si lo dejas vacío, se detecta automáticamente según la clave presente.
AI_PROVIDER=gemini

# --- Google Gemini (tiene nivel gratuito: https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Groq (nivel gratuito, compatible con OpenAI)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

